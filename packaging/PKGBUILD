# Maintainer: musqz
pkgname=mabox-snapshot
pkgver=0.2.2
pkgrel=1
pkgdesc="Snapshot a running Mabox Linux system into a bootable live/install ISO"
arch=('any')
url="https://github.com/musqz/mabox-snapshot"
license=('MIT')
depends=(
    'python'
    'squashfs-tools'
    'libisoburn'
    'grub'
    'mkinitcpio'
    'mkinitcpio-nfs-utils'
    'manjaro-tools-iso-git'
    'nbd'
    'curl'
    'dosfstools'
    'rsync'
    'openssl'
)
optdepends=(
    'calamares: install-from-live-ISO support'
    'imagemagick: GRUB splash / Calamares branding image normalization'
    'yay: AUR-reproducibility check for foreign packages'
    'cryptsetup: --encrypt LUKS2-encrypted preserving-mode ISOs'
    'bash-completion: tab-completion for the mabox-snapshot CLI'
)
makedepends=('python-build' 'python-installer' 'python-hatchling')
checkdepends=('python-pytest')
backup=('etc/mabox-snapshot/excludes.list')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('41ac68dd5cec27986af511fb8764b079284b87d038f1ef0510c64a828b9a550f')

build() {
    cd "$pkgname-$pkgver"
    python -m build --wheel --no-isolation
}

check() {
    cd "$pkgname-$pkgver"
    python -m pytest tests/unit/ -q
}

package() {
    cd "$pkgname-$pkgver"
    python -m installer --destdir="$pkgdir" dist/*.whl

    install -Dm644 configs/excludes.list.default \
        "$pkgdir/usr/share/mabox-snapshot/excludes.list.default"
    install -Dm644 configs/excludes.list.default \
        "$pkgdir/etc/mabox-snapshot/excludes.list"

    mkdir -p "$pkgdir/usr/share/mabox-snapshot/mabox-skel"
    cp -a configs/mabox-skel/skel "$pkgdir/usr/share/mabox-snapshot/mabox-skel/skel"

    # The umask-safety chmod pass below flattens every file to 644 --
    # capture which vendored skel files are meant to stay executable
    # (tint2's Executor plugin runs some of these directly, e.g.
    # .config/tint2/scripts/*) from the source tree now, before that
    # information is lost, and restore it after.
    mabox_skel_exec_files=$(find configs/mabox-skel/skel -type f -perm -u+x -printf '%P\n')

    install -Dm644 configs/initcpio/hooks/miso_luks \
        "$pkgdir/usr/lib/initcpio/hooks/miso_luks"
    install -Dm644 configs/initcpio/install/miso_luks \
        "$pkgdir/usr/lib/initcpio/install/miso_luks"

    sed "s/@VERSION@/$pkgver/" man/mabox-snapshot.1 > man/mabox-snapshot.1.built
    install -Dm644 man/mabox-snapshot.1.built \
        "$pkgdir/usr/share/man/man1/mabox-snapshot.1"

    install -Dm644 completions/mabox-snapshot.bash \
        "$pkgdir/usr/share/bash-completion/completions/mabox-snapshot"

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

    # Umask-safety pass -- see mabox_snapshot/permissions.py's docstring for
    # why this can't be skipped: mkdir/install calls above are still shaped
    # by the calling shell's umask.
    find "$pkgdir" -type d -exec chmod 755 {} +
    find "$pkgdir" -type f -exec chmod 644 {} +
    find "$pkgdir/usr/bin" -type f -exec chmod 755 {} + 2>/dev/null || true
    while IFS= read -r rel; do
        [ -n "$rel" ] && chmod 755 "$pkgdir/usr/share/mabox-snapshot/mabox-skel/skel/$rel"
    done <<< "$mabox_skel_exec_files"
}
