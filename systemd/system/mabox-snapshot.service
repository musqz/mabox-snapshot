[Unit]
Description=Create a Mabox Linux snapshot ISO
Documentation=https://github.com/musqz/mabox-snapshot
ConditionACPower=true

[Service]
Type=oneshot
# --mode preserving only: this is unattended personal-backup automation,
# not the sharing/reset workflow. --encrypt is never passed here -- its
# passphrase prompt requires a real terminal by design (see luks.py) and
# would fail every unattended run; a --backup-to config value covers the
# "protect this off the local disk" use case instead.
ExecStart=/usr/bin/mabox-snapshot create --mode preserving
Nice=19
IOSchedulingClass=idle
