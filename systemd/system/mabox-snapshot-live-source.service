[Unit]
Description=Remount the decrypted live rootfs at a stable path for Calamares
Documentation=https://github.com/musqz/mabox-snapshot
# --encrypt builds' rootfs.sfs.luks is decrypted once, early in the
# initramfs, by the miso_luks boot hook (configs/initcpio/hooks/miso_luks's
# _mnt_luks_sfs()) -- but that mount, at /run/miso/sfs/rootfs, does not
# survive switch_root into the running system (verified: it's an empty,
# orphaned directory post-boot, even from PID 1's own mount namespace,
# while the live desktop session keeps working fine regardless, since
# overlayfs doesn't need the original mount path to stay valid once it's
# already built the live root from it). The underlying dm-crypt mapping
# itself (/dev/mapper/mabox_rootfs -- must match
# mabox_snapshot.constants.ISO_LUKS_MAPPER_NAME) DOES survive, since /dev
# is reliably carried over. This unit just remounts that already-unlocked
# device at a fresh, stable path Calamares' unpackfs can actually read
# from (mabox_snapshot.constants.MISO_LUKS_LIVE_ROOTFS_MOUNT) -- no
# second passphrase prompt needed, since the mapping is already unlocked.
#
# A silent no-op on every system except a live boot of an --encrypt
# build: ConditionPathExists skips this unit entirely when the mapper
# device doesn't exist (every installed system, and non-encrypted live
# boots), so it's safe to enable unconditionally on every install.
#
# Ordered After (not Before) multi-user.target, deliberately late --
# verified empirically that an early placement (After=local-fs-pre.target,
# DefaultDependencies=no) reports success (ExecStart exits 0) but the
# mount doesn't actually stick: checked later, the target directory is
# empty again, even though a fresh manual mount of the same device at
# the same point in the session works perfectly. Something during early
# boot shadows or discards a mount made that early; ordering this well
# after the system has finished normal startup avoids it, and still runs
# automatically, long before a user could interactively launch Calamares.
ConditionPathExists=/dev/mapper/mabox_rootfs
After=multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/mkdir -p /run/mabox-snapshot/live-source
ExecStart=/usr/bin/mount -o ro /dev/mapper/mabox_rootfs /run/mabox-snapshot/live-source

[Install]
WantedBy=multi-user.target
