#!/bin/bash

# mabox-snapshot addition: a vendored copy of the external
# manjaro-tools-iso-git "miso" install script, unmodified. Exists only so
# hooks/miso_boot's fixed _find_dev_by_path() ships instead of the
# external package's own "miso" hook -- see hooks/miso_boot for why.

build() {
    add_module "cdrom"
    add_module "loop"
    add_module "dm-snapshot"
    add_module "overlay"

    add_runscript

    add_binary /usr/lib/udev/cdrom_id
    add_binary blockdev
    add_binary dmsetup
    add_binary losetup
    add_binary mountpoint
    add_binary truncate
    add_binary gpg
    add_binary grep

    add_file /usr/lib/udev/rules.d/60-cdrom_id.rules
    add_file /usr/lib/udev/rules.d/10-dm.rules
    add_file /usr/lib/udev/rules.d/95-dm-notify.rules
    if [[ $MISO_GNUPG_FD ]]; then
        mkdir -p "$BUILDROOT$dest"/gpg
        gpg --homedir "$BUILDROOT$dest"/gpg --import <&$MISO_GNUPG_FD
    fi
}

